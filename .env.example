# edu-platform-backend environment configuration.
# Copy to `.env` and fill in real values. NEVER commit your real `.env`.

# --- Runtime ---
NODE_ENV=development            # development | production | test
PORT=8000
HOST=0.0.0.0
BASE_URL=http://localhost:8000

# --- Security (required) ---
# JWT_SECRET must be at least 32 characters. Generate one with:
#   openssl rand -hex 32
JWT_SECRET=

# CORS: explicit, comma-separated origin allow-list (credentialed CORS).
# "*" is allowed ONLY in development. In production an empty value or "*"
# makes the server refuse to boot.
ALLOWED_ORIGINS=http://localhost:3000

# --- Database (required) ---
DATABASE_URL=postgresql://user:password@localhost:5432/edu_platform

# --- Auth token lifetimes (optional; defaults shown) ---
PASSWORD_SETUP_TOKEN_TTL_MINUTES=1440
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# --- Rate limiting (optional; global lenient backstop, defaults shown) ---
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW=1 minute

# --- Email (Brevo) ---
BREVO_API_KEY=
SENDER_NAME=
SENDER_EMAIL=
